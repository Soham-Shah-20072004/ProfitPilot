# Copy to .env to change settings. Every variable is optional.

# Database: SQLite file by default; PostgreSQL for scale
# PP_DATABASE_URL=postgresql+psycopg://profitpilot:profitpilot@localhost:5432/profitpilot

# Create the demo seller and its five products on first start
PP_SEED_DEMO=true

# Serve the app (frontend/index.html) at /
PP_SERVE_FRONTEND=true

# If set, write endpoints need the header X-API-Key: <value>
PP_API_KEY=

# Background loop that runs due day-14 / day-28 checks (seconds; 0 = off)
PP_JOBS_INTERVAL_SEC=60

# Allow /api/v1/admin/clock/advance (demo time travel). Turn off in production.
PP_DEMO_CLOCK=true

# Use models/elasticity.json (python -m app.ml.training.train_elasticity) for β instead of the −3 prior
PP_USE_LEARNED_MODELS=false

# Allowed browser origins (JSON list)
PP_CORS_ORIGINS=["*"]

# ---- AI layer (Gemini). Leave empty to run on the rule-based engine only.
# Get a key at https://aistudio.google.com/apikey . It stays on the server; the browser never sees it.
GEMINI_API_KEY=
# PP_GEMINI_MODEL=gemini-2.5-flash
# PP_AI_ENABLED=true
# PP_AI_RATE_PER_MIN=30
